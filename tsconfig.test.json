{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".tmp-test",
    "rootDir": ".",
    "target": "ES2022"
  },
  "include": [
    "src/native/i18n/**/*.ts",
    "src/native/i18n/**/*.tsx",
    "src/native/app/navigation/navigationLogic.ts",
    "src/native/screens/auth/authLogic.ts",
    "src/native/domain/auth/authPolicy.ts",
    "src/native/screens/chat/paymentUtils.ts",
    "src/native/domain/credentials/**/*.ts",
    "src/native/domain/scan/**/*.ts",
    "src/native/domain/payment/**/*.ts",
    "src/native/screens/chat-list/chatListLogic.ts",
    "src/native/screens/chat-list/chatSearchLogic.ts",
    "src/native/domain/app-store/appStoreStateService.ts",
    "src/native/domain/app-store/appStatePersistence.ts",
    "src/native/data/demo/identityDemoData.ts",
    "src/native/screens/settings/activity/activityLogLogic.ts",
    "src/native/screens/news-feed/search/newsFeedSearchLogic.ts",
    "src/native/platform/runtimeGlobals.ts",
    "src/native/data/wallet/**/*.ts",
    "src/native/domain/wallet/walletContainer.ts",
    "src/native/domain/wallet/credentialPresentation.ts",
    "src/native/domain/wallet/walletMessages.ts",
    "src/native/domain/wallet/walletViews.ts",
    "src/native/domain/wallet/walletFlows.ts",
    "src/native/domain/wallet/pinnedRoots.ts",
    "src/native/domain/wallet/presentationFlow.ts"
  ]
}
